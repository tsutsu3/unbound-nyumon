{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "unbound-nyumon",
  "compatibility_date": "2026-09-23",

  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },

  "cache": {
    "enabled": true,
  },

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
    },
  },

  "env": {
    "prd": {
      "name": "unbound-nyumon-prd",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "unbound-nyumon.tsutsu3.com",
          "custom_domain": true,
        },
      ],
    },
    "dev": {
      "name": "unbound-nyumon-dev",
      "workers_dev": true,
      "routes": [],
    },
  },
}
